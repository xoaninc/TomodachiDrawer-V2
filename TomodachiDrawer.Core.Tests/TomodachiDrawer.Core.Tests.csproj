<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit.v3" Version="3.2.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- Skia's Linux natives do not flow transitively from Core, and these projects create
         SKBitmaps, so on a Linux CI runner they fail with "Unable to load shared library
         libSkiaSharp". Same pin as the UI project, same version as Core's SkiaSharp. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.150.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TomodachiDrawer.Core\TomodachiDrawer.Core.csproj" />
    <!-- For TraceRenderer. It lives in the bench rather than Core because nothing that ships needs
         to render; referencing it here avoids a second copy that could drift from the drawer. -->
    <ProjectReference Include="..\TomodachiDrawer.Bench\TomodachiDrawer.Bench.csproj" />
  </ItemGroup>
</Project>
