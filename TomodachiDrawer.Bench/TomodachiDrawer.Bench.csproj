<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Measurement only. Never referenced by the shipping app; run with -c Release. -->
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TomodachiDrawer.Core\TomodachiDrawer.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Skia's Linux natives do not flow transitively from Core, and these projects create
         SKBitmaps, so on a Linux CI runner they fail with "Unable to load shared library
         libSkiaSharp". Same pin as the UI project, same version as Core's SkiaSharp. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.151.1" />
  </ItemGroup>
</Project>
